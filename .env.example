# OpenAI API configuration
# Each team member uses their own key in their own (gitignored) .env file,
# with a monthly budget set in the OpenAI dashboard.
OPENAI_API_KEY=
# Model names: confirm current names on OpenAI's models page.
# Both must support image input, function calling and JSON-schema structured output.
# Small, low-cost model for vision tagging and itinerary/event parsing:
OPENAI_MODEL_FAST=
# Stronger model for the agent's tool-calling and reasoning:
OPENAI_MODEL_AGENT=
